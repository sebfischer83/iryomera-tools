<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>iryomera-mod</ToolCommandName>
    <Description>Offline authoring, validation and safe packaging of data-only Iryomera mods.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Iryomera.ModKit.Core/Iryomera.ModKit.Core.csproj" />
    <PackageReference Include="System.CommandLine" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="/" />
    <None Include="../../MODKIT-THIRD-PARTY-NOTICES.md" Link="MODKIT-THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="/" />
    <None Include="../../third-party/*.txt" Link="third-party/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="third-party" />
  </ItemGroup>
</Project>
