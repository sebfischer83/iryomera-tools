@inherits StudioPage
@inject ProjectService Projects
<h2>@L["studio.section.gameplay"]</h2><p class="notice">@L["studio.simulationNotice"]</p><Feedback Error="Error" Message="@Message" />
<EditForm Model="Model" OnSubmit="Save" FormName="gameplay">
    <div class="card columns">
        <label>@L["studio.rarity"]<InputNumber @bind-Value="Model.Rarity" step="any" /></label>
        <label>@L["studio.severity"]<InputNumber @bind-Value="Model.Severity" step="any" /></label>
        <label>@L["studio.duration"]<InputNumber @bind-Value="Model.Duration" step="any" /></label>
        <label>@L["studio.examinationDuration"]<InputNumber @bind-Value="Model.ExaminationDuration" step="any" /></label>
        <label>@L["studio.examinationCost"]<InputNumber @bind-Value="Model.ExaminationCost" step="any" /></label>
        <label>@L["studio.treatmentCost"]<InputNumber @bind-Value="Model.TreatmentCost" step="any" /></label>
        <label>@L["studio.difficulty"]<InputNumber @bind-Value="Model.Difficulty" step="any" /></label>
        <label>@L["studio.successProbability"]<InputNumber @bind-Value="Model.Success" step="any" /></label>
        <label>@L["studio.capacity"]<InputNumber @bind-Value="Model.Capacity" step="any" /></label>
        <label>@L["studio.purchasecost"]<InputNumber @bind-Value="Model.PurchaseCost" step="any" /></label>
        <label>@L["studio.wageperhour"]<InputNumber @bind-Value="Model.WagePerHour" step="any" /></label>
        <label>@L["studio.unlockcost"]<InputNumber @bind-Value="Model.UnlockCost" step="any" /></label>
        <label>@L["studio.unlockdischargedpatients"]<InputNumber @bind-Value="Model.UnlockDischargedPatients" step="1" /></label>
        <label>@L["studio.openfromhour"]<InputNumber @bind-Value="Model.OpenFromHour" step="1" /></label>
        <label>@L["studio.opentohour"]<InputNumber @bind-Value="Model.OpenToHour" step="1" /></label>
        <label>@L["studio.arrival"]<InputSelect @bind-Value="Model.Arrival"><option value="">@L["studio.arrival.none"]</option>@foreach (var arrival in Enum.GetValues<PatientArrival>()) { <option value="@arrival">@L["studio.arrival." + arrival.ToString().ToLowerInvariant()]</option> }</InputSelect></label>
        <label>@L["studio.staydurationseconds"]<InputNumber @bind-Value="Model.StayDurationSeconds" step="any" /></label>
        <label>@L["studio.staydurationmaxseconds"]<InputNumber @bind-Value="Model.StayDurationMaxSeconds" step="any" /></label>
        <label>@L["studio.staychance"]<InputNumber @bind-Value="Model.StayChance" step="any" /></label>
        <label>@L["studio.complicationchance"]<InputNumber @bind-Value="Model.ComplicationChance" step="any" /></label>
        <label>@L["studio.extrastaydurationseconds"]<InputNumber @bind-Value="Model.ExtraStayDurationSeconds" step="any" /></label>
        <label>@L["studio.comfort"]<InputNumber @bind-Value="Model.Comfort" step="1" /></label>
        <label>@L["studio.minimumreputation"]<InputNumber @bind-Value="Model.MinimumReputation" step="any" /></label>
        <label>@L["studio.pricefactor"]<InputNumber @bind-Value="Model.PriceFactor" step="any" /></label>
        <label>@L["studio.patientshare"]<InputNumber @bind-Value="Model.PatientShare" step="any" /></label>
    </div>
    <section class="card"><h3>@L["studio.requiredResources"]</h3><p>@L["studio.requirementsHint"]</p>
        @foreach (var row in Resources)
        { <div class="toolbar" @key="row"><label>@L["studio.resource"]<input @bind="row.Key" list="resource-options" /></label><label>@L["studio.quantity"]<input type="number" step="any" @bind="row.Quantity" /></label><button type="button" class="secondary" @onclick="() => Resources.Remove(row)">@L["studio.remove"]</button></div> }
        <datalist id="resource-options">@foreach (var definition in State.Package.Definitions.Where(d => d is RoomDefinition or MedicalEquipmentDefinition or StaffRoleDefinition or StaffQualificationDefinition or FurnitureDefinition)) { <option value="@definition.Id">@StudioContent.Name(State, definition, CultureInfo.CurrentUICulture.Name)</option> }</datalist>
        <button type="button" @onclick="() => Resources.Add(new())">@L["studio.addResource"]</button>
    </section>
    <section class="card"><label>@L["studio.reviewer"]<InputText @bind-Value="Actor" required /></label><label>@L["studio.reason"]<InputTextArea @bind-Value="Note" required /></label><button type="submit" disabled="@Busy">@L["studio.saveSimulation"]</button></section>
</EditForm>
@code {
    [Parameter] public ProjectSnapshot State { get; set; } = null!; [Parameter] public string DefinitionId { get; set; } = ""; [Parameter] public EventCallback OnChanged { get; set; }
    private BalanceModel Model = new(); private List<ResourceRow> Resources = []; private string Actor = ""; private string Note = ""; private long LoadedRevision = -1;
    protected override void OnParametersSet()
    {
        if (LoadedRevision == State.Project.Revision) return; LoadedRevision = State.Project.Revision;
        var old = State.Package.Gameplay.Find(b => b.DefinitionId == DefinitionId);
        Model = new() { Rarity = old?.Rarity, Severity = old?.Severity, Duration = old?.TreatmentDurationSeconds, ExaminationDuration = old?.ExaminationDurationSeconds, ExaminationCost = old?.ExaminationCost, TreatmentCost = old?.TreatmentCost, Difficulty = old?.DiagnosticDifficulty, Success = old?.SimulatedSuccessProbability, Capacity = old?.Capacity, PurchaseCost = old?.PurchaseCost, WagePerHour = old?.WagePerHour, UnlockCost = old?.UnlockCost, UnlockDischargedPatients = old?.UnlockDischargedPatients,
            OpenFromHour = old?.OpenFromHour, OpenToHour = old?.OpenToHour, Arrival = old?.Arrival, StayDurationSeconds = old?.StayDurationSeconds,
            StayDurationMaxSeconds = old?.StayDurationMaxSeconds, StayChance = old?.StayChance, ComplicationChance = old?.ComplicationChance, ExtraStayDurationSeconds = old?.ExtraStayDurationSeconds,
            Comfort = old?.Comfort, MinimumReputation = old?.MinimumReputation, PriceFactor = old?.PriceFactor, PatientShare = old?.PatientShare };
        Resources = old?.RequiredResources.Select(r => new ResourceRow { Key = r.Key, Quantity = r.Value }).ToList() ?? [];
    }
    private Task Save() => Run(async () =>
    {
        await Projects.SaveGameplayAsync(State.Project.Id, State.Project.Revision, new()
        { DefinitionId = DefinitionId, Rarity = Model.Rarity, Severity = Model.Severity, TreatmentDurationSeconds = Model.Duration, ExaminationDurationSeconds = Model.ExaminationDuration, ExaminationCost = Model.ExaminationCost, TreatmentCost = Model.TreatmentCost, DiagnosticDifficulty = Model.Difficulty, SimulatedSuccessProbability = Model.Success, Capacity = Model.Capacity, PurchaseCost = Model.PurchaseCost, WagePerHour = Model.WagePerHour, UnlockCost = Model.UnlockCost, UnlockDischargedPatients = Model.UnlockDischargedPatients,
            OpenFromHour = Model.OpenFromHour, OpenToHour = Model.OpenToHour, Arrival = Model.Arrival, StayDurationSeconds = Model.StayDurationSeconds,
            StayDurationMaxSeconds = Model.StayDurationMaxSeconds, StayChance = Model.StayChance, ComplicationChance = Model.ComplicationChance, ExtraStayDurationSeconds = Model.ExtraStayDurationSeconds,
            Comfort = Model.Comfort, MinimumReputation = Model.MinimumReputation, PriceFactor = Model.PriceFactor, PatientShare = Model.PatientShare, RequiredResources = Resources.ToDictionary(r => r.Key, r => r.Quantity, StringComparer.Ordinal) }, Actor, Note);
        await OnChanged.InvokeAsync();
    });
    private sealed class BalanceModel { public decimal? Rarity { get; set; } public decimal? Severity { get; set; } public decimal? Duration { get; set; } public decimal? ExaminationDuration { get; set; } public decimal? ExaminationCost { get; set; } public decimal? TreatmentCost { get; set; } public decimal? Difficulty { get; set; } public decimal? Success { get; set; } public decimal? Capacity { get; set; } public decimal? PurchaseCost { get; set; } public decimal? WagePerHour { get; set; } public decimal? UnlockCost { get; set; } public decimal? UnlockDischargedPatients { get; set; } public decimal? OpenFromHour { get; set; } public decimal? OpenToHour { get; set; } public PatientArrival? Arrival { get; set; } public decimal? StayDurationSeconds { get; set; } public decimal? StayDurationMaxSeconds { get; set; } public decimal? StayChance { get; set; } public decimal? ComplicationChance { get; set; } public decimal? ExtraStayDurationSeconds { get; set; } public decimal? Comfort { get; set; } public decimal? MinimumReputation { get; set; } public decimal? PriceFactor { get; set; } public decimal? PatientShare { get; set; } }
    private sealed class ResourceRow { public string Key { get; set; } = ""; public decimal Quantity { get; set; } = 1; }
}
