<Router AppAssembly="typeof(global::Program).Assembly">
    <Found Context="route"><RouteView RouteData="route" DefaultLayout="typeof(Layout.MainLayout)" /><FocusOnNavigate RouteData="route" Selector="h1" /></Found>
    <NotFound><LayoutView Layout="typeof(Layout.MainLayout)"><p>404</p></LayoutView></NotFound>
</Router>
