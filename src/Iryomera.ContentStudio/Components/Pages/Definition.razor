@page "/projects/{Id:guid}/definitions/{ContentId}"
@page "/projects/{Id:guid}/new"
@inherits StudioPage
@inject ProjectService Projects
<Feedback Error="Error" Message="@Message" />
@if (State is not null && Model is not null)
{
    <h1>@(Existing is null ? L["studio.newDefinition"] : StudioContent.Name(State, Existing, CultureInfo.CurrentUICulture.Name))</h1><ProjectNav Id="Id" />
    <nav class="tabs" aria-label="@L["studio.editorSections"]">@foreach (var section in Sections) { <button class="@(Section == section ? "selected" : "secondary")" @onclick="() => Section = section">@L["studio.section." + section]</button> }</nav>
    @if (Section is "general" or "translations" or "classifications" or "sources")
    {
        <EditForm Model="Model" OnSubmit="Save" FormName="definition">
            @if (Section == "general")
            {
                <section class="card"><h2>@L["studio.section.general"]</h2><div class="columns">
                    <label>@L["studio.id"]<InputText @bind-Value="Model.Id" readonly="@(Existing is not null)" required /></label>
                    <label>@L["studio.kind"]<InputSelect @bind-Value="Model.Kind" disabled="@(Existing is not null)">@foreach (var kind in StudioContent.Kinds) { <option value="@kind">@L["studio.kind." + kind]</option> }</InputSelect></label>
                    <label>@L["studio.version"]<InputText @bind-Value="Model.Version" required /></label>
                </div><p>@L["studio.idHint"]</p></section>
            }
            @if (Section is "translations" or "general")
            {
                <section class="card"><h2>@L["studio.section.translations"]</h2><div class="columns">
                    <div><h3>English (en)</h3><label>@L["studio.name"]<InputText @bind-Value="Model.NameEn" required /></label><label>@L["studio.description"]<InputTextArea @bind-Value="Model.DescriptionEn" /></label><label>@L["studio.synonyms"]<InputTextArea @bind-Value="Model.SynonymsEn" /></label></div>
                    <div><h3>Deutsch (de)</h3><label>@L["studio.name"]<InputText @bind-Value="Model.NameDe" /></label><label>@L["studio.description"]<InputTextArea @bind-Value="Model.DescriptionDe" /></label><label>@L["studio.synonyms"]<InputTextArea @bind-Value="Model.SynonymsDe" /></label></div>
                </div><p>@L["studio.synonymHint"]</p></section>
            }
            @if (Section == "classifications") { <section class="card"><h2>@L["studio.section.classifications"]</h2><p>@L["studio.classificationHint"]</p><InputTextArea class="json" @bind-Value="Model.ClassificationsJson" /></section> }
            @if (Section == "sources" || Existing is null)
            {
                <section class="card"><h2>@L["studio.section.sources"]</h2><div class="columns">
                    <label>@L["studio.source"]<InputText @bind-Value="Model.Source" readonly="@(Existing is not null)" /></label><label>@L["studio.externalId"]<InputText @bind-Value="Model.ExternalId" readonly="@(Existing is not null)" /></label>
                    <label>@L["studio.sourceVersion"]<InputText @bind-Value="Model.SourceVersion" readonly="@(Existing is not null)" /></label><label>@L["studio.license"]<InputText @bind-Value="Model.License" readonly="@(Existing is not null)" /></label>
                </div>@if (Existing is not null) { <details><summary>@L["studio.originalSource"]</summary><pre>@StudioContent.Json(Existing)</pre></details> }</section>
            }
            <section class="card"><label>@L["studio.reviewer"]<InputText @bind-Value="Model.Actor" required /></label><label>@L["studio.reason"]<InputTextArea @bind-Value="Model.Note" required /></label><p>@L["studio.editResetsReview"]</p><button type="submit" disabled="@Busy">@L["studio.saveDraft"]</button></section>
        </EditForm>
    }
    else if (Existing is not null && Section == "assets") { <AssetEditor State="State" Definition="Existing" OnChanged="Load" /> }
    else if (Existing is not null && Section == "gameplay") { <GameplayEditor State="State" DefinitionId="@Existing.Id" OnChanged="Load" /> }
    else if (Existing is not null && Section == "relationships")
    {
        <h2>@L["studio.section.relationships"]</h2><a class="button" href="@($"/projects/{Id}/relations?focus={Uri.EscapeDataString(Existing.Id)}")">@L["studio.openGraph"]</a>
        @foreach (var kind in Enum.GetValues<RelationKind>())
        {
            var relations = State.Package.Relations.Where(r => r.Kind == kind && (r.FromId == Existing.Id || r.ToId == Existing.Id)).ToArray();
            @if (relations.Length > 0) { <section class="card"><h3>@L["studio.relation." + kind]</h3><ul>@foreach (var relation in relations) { <li><code>@relation.FromId → @relation.ToId</code> · @L["studio.status." + relation.Provenance.ReviewStatus]</li> }</ul></section> }
        }
        <section class="card"><h3>@L["studio.requiredResources"]</h3><p>@L["studio.requirementsHint"]</p>
            <ul>@foreach (var resource in State.Package.Gameplay.Find(g => g.DefinitionId == Existing.Id)?.RequiredResources ?? []) { <li>@resource.Key: @resource.Value</li> }</ul>
            <p>@L["studio.equipmentPersonnelHint"]</p>
            <ul>@foreach (var requirement in DerivedRequirements()) { <li><code>@requirement</code></li> }</ul>
        </section>
        @foreach (var annotation in State.Package.MedicalAnnotations.Where(a => new[] { a.Subject.ContentId, a.Object.ContentId, a.DiseaseContext?.ContentId }.Contains(Existing.Id)))
        { <section class="card"><h3>@L["studio.annotation"]</h3><pre>@StudioContent.Json(annotation)</pre><a href="@($"/projects/{Id}/annotations/{Uri.EscapeDataString(annotation.Id)}")">@L["studio.edit"]</a></section> }
    }
    else if (Existing is not null && Section == "review") { <ReviewPanel ProjectId="Id" Revision="State.Project.Revision" RecordId="@Existing.Id" Provenance="Existing.Provenance" OnChanged="Load" /> }
}
@code {
    [Parameter] public Guid Id { get; set; } [Parameter] public string? ContentId { get; set; }
    private ProjectSnapshot? State; private ContentDefinition? Existing; private DefinitionEdit? Model;
    private string Section = "general";
    private readonly string[] Sections = ["general", "classifications", "relationships", "assets", "gameplay", "translations", "sources", "review"];
    protected override Task OnParametersSetAsync() => Run(Load);
    private async Task Load()
    {
        State = await Projects.GetAsync(Id); Existing = ContentId is null ? null : State.Package.Definitions.Single(d => d.Id == ContentId);
        Model = Existing is null ? new() { Id = State.Package.Manifest.Namespace + ":new_definition" } : ProjectService.EditModel(State, Existing);
    }
    private Task Save() => Run(async () => { await Projects.SaveDefinitionAsync(Id, State!.Project.Revision, Model!, Existing is null); if (Existing is null) Nav.NavigateTo($"/projects/{Id}/definitions/{Uri.EscapeDataString(Model!.Id)}"); else await Load(); });
    private IEnumerable<string> DerivedRequirements()
    {
        var related = State!.Package.Relations.Where(r => r.FromId == Existing!.Id && r.Kind is RelationKind.DiseaseExamination or RelationKind.DiseaseTreatment).Select(r => r.ToId).ToHashSet(StringComparer.Ordinal);
        return State.Package.Relations.Where(r => related.Contains(r.FromId) && r.Kind is RelationKind.ExaminationEquipment or RelationKind.TreatmentEquipment or RelationKind.TreatmentQualification).Select(r => r.ToId).Distinct(StringComparer.Ordinal);
    }
}
