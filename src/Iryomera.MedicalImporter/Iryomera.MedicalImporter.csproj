<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>iryomera-medical</ToolCommandName>
    <Description>Offline, reproducible medical source import, review staging and validated JSON export.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Iryomera.Content.SDK/Iryomera.Content.SDK.csproj" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="CsvHelper" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../schemas/importer/v1/contracts.schema.json" LogicalName="Iryomera.MedicalImporter.Schemas.v1.json" /></ItemGroup>
  <ItemGroup><None Include="../../schemas/importer/v1/*.json" Pack="true" PackagePath="schemas/importer/v1" /></ItemGroup>
  <ItemGroup>
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="/" />
    <None Include="../../third-party/*.txt" Link="third-party/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="third-party" />
  </ItemGroup>
</Project>
