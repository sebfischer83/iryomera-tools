{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iryomera.org/studio/v1/contracts.schema.json",
  "$defs": {
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "externalId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewStatus": {
          "enum": [
            "unreviewed",
            "inReview",
            "approved",
            "rejected"
          ]
        },
        "reviewedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      },
      "required": [
        "source",
        "externalId",
        "sourceVersion",
        "license",
        "importedAt"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "reviewStatus": {
                "enum": [
                  "approved",
                  "rejected"
                ]
              }
            },
            "required": [
              "reviewStatus"
            ]
          },
          "then": {
            "required": [
              "reviewedBy",
              "reviewedAt"
            ],
            "properties": {
              "reviewedBy": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "evidenceReference": {
      "type": "object",
      "properties": {
        "citation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "citation"
      ],
      "additionalProperties": true
    },
    "studioReviewedRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*:[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$(?![\\s\\S])"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "id",
        "provenance"
      ],
      "additionalProperties": false
    },
    "studioPermissionNotice": {
      "type": "object",
      "properties": {
        "recordId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*:[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$(?![\\s\\S])"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "permitted": {
          "type": "boolean"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "atUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "recordId",
        "digest",
        "permitted",
        "reviewer",
        "evidence",
        "atUtc"
      ],
      "additionalProperties": false
    },
    "studioReleaseReport": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "rightsReviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rightsNote": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "approvedRecords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/studioReviewedRecord"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/studioPermissionNotice"
          }
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "revision",
        "rightsReviewer",
        "rightsNote"
      ],
      "additionalProperties": false
    }
  }
}
