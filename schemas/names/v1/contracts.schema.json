{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iryomera.org/names/v1/contracts.schema.json",
  "title": "Iryomera name importer staging contracts v1",
  "$defs": {
    "nameImportOptions": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "us-ssa",
            "us-census-surnames",
            "at-statistik",
            "wikidata-names",
            "names-sigpwned"
          ]
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "licenseText": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$(?![\\s\\S])"
        },
        "birthYear": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9999
            },
            {
              "type": "null"
            }
          ]
        },
        "retrievedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "languageCountries": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$(?![\\s\\S])"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Z]{2}$(?![\\s\\S])"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "maxInputBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "source",
        "sourceVersion",
        "sourceUrl",
        "license",
        "licenseText",
        "attribution",
        "importedAt"
      ],
      "additionalProperties": false
    },
    "nameRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*:[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$(?![\\s\\S])"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$(?![\\s\\S])"
        },
        "region": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "part": {
          "enum": [
            "given",
            "family"
          ]
        },
        "localized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(.*\\S)?$(?![\\s\\S])"
        },
        "romanized": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^\\S(.*\\S)?$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "romanizationOrigin": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "gender": {
          "anyOf": [
            {
              "enum": [
                "female",
                "male",
                "unisex",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "proportion": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "birthYearFrom": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9999
            },
            {
              "type": "null"
            }
          ]
        },
        "birthYearTo": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9999
            },
            {
              "type": "null"
            }
          ]
        },
        "externalId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceFields": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "country",
        "part",
        "localized"
      ],
      "additionalProperties": false
    },
    "nameDiagnostic": {
      "type": "object",
      "properties": {
        "severity": {
          "enum": [
            "information",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "recordId": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "severity",
        "code",
        "recordId",
        "message"
      ],
      "additionalProperties": false
    },
    "nameBatch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^batch_[0-9a-f]{64}$(?![\\s\\S])"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "inputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "options": {
          "$ref": "#/$defs/nameImportOptions"
        },
        "adapterVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$(?![\\s\\S])"
        },
        "detectedFormat": {
          "enum": [
            "csv",
            "json"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nameRecord"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nameDiagnostic"
          }
        }
      },
      "required": [
        "id",
        "inputSha256",
        "inputBytes",
        "options",
        "adapterVersion",
        "detectedFormat"
      ],
      "additionalProperties": false
    },
    "nameReviewDecision": {
      "type": "object",
      "properties": {
        "batchId": {
          "type": "string",
          "pattern": "^batch_[0-9a-f]{64}$(?![\\s\\S])"
        },
        "recordId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*:[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "unreviewed",
            "inReview",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "batchId",
        "status",
        "reviewer",
        "at",
        "note"
      ],
      "additionalProperties": false
    },
    "nameRightsDecision": {
      "type": "object",
      "properties": {
        "batchId": {
          "type": "string",
          "pattern": "^batch_[0-9a-f]{64}$(?![\\s\\S])"
        },
        "decision": {
          "enum": [
            "undecided",
            "permitted",
            "blocked"
          ]
        },
        "permissionEvidence": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "batchId",
        "decision",
        "reviewer",
        "at",
        "note"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "permitted"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "required": [
              "permissionEvidence"
            ],
            "properties": {
              "permissionEvidence": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "nameWorkspace": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "batches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nameBatch"
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nameReviewDecision"
          }
        },
        "rights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nameRightsDecision"
          }
        }
      },
      "required": [
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    "nameReleaseBatch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^batch_[0-9a-f]{64}$(?![\\s\\S])"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "exportedRecords": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "source",
        "sourceVersion",
        "license",
        "inputSha256",
        "exportedRecords"
      ],
      "additionalProperties": false
    },
    "nameReleasePool": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*:[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$(?![\\s\\S])"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$(?![\\s\\S])"
        },
        "region": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "part": {
          "enum": [
            "given",
            "family"
          ]
        },
        "entries": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "country",
        "part",
        "entries"
      ],
      "additionalProperties": false
    },
    "nameReleaseReport": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "packageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*:[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$(?![\\s\\S])"
        },
        "batches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nameReleaseBatch"
          }
        },
        "pools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nameReleasePool"
          }
        }
      },
      "required": [
        "schemaVersion",
        "packageId",
        "version"
      ],
      "additionalProperties": false
    }
  }
}
