{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iryomera.org/v1/contracts.schema.json",
  "title": "Iryomera v1 exchange contracts",
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "properties": {
        "citation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "citation"
      ],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "externalId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewStatus": {
          "enum": [
            "unreviewed",
            "inReview",
            "approved",
            "rejected"
          ]
        },
        "reviewedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      },
      "required": [
        "source",
        "externalId",
        "sourceVersion",
        "license",
        "importedAt"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "reviewStatus": {
                "enum": [
                  "approved",
                  "rejected"
                ]
              }
            },
            "required": [
              "reviewStatus"
            ]
          },
          "then": {
            "required": [
              "reviewedBy",
              "reviewedAt"
            ],
            "properties": {
              "reviewedBy": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "externalIdentifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "system",
        "value",
        "provenance"
      ],
      "additionalProperties": true
    },
    "diseaseDefinition": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "disease"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*:[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$(?![\\s\\S])"
        },
        "nameKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$(?![\\s\\S])"
        },
        "descriptionKey": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$(?![\\s\\S])"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "classifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalIdentifier"
          }
        },
        "synonymKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$(?![\\s\\S])"
          }
        }
      },
      "required": [
        "kind",
        "id",
        "nameKey",
        "version",
        "provenance"
      ],
      "additionalProperties": true
    },
