<?xml version="1.0" encoding="utf-8"?>
<!-- Restore only from nuget.org, independent of user-level sources (NU1507 with central package management). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
